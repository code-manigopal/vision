# Copy to .env and fill in what you have. Blank = not configured yet.
# Never share or commit .env.

# --- Phase 1 ---
TOMTOM_API_KEY=            # Traffic Desk (free tier: developer.tomtom.com)
GEOCODER=tomtom            # tomtom | google
GOOGLE_MAPS_API_KEY=       # optional: only if GEOCODER=google, and for the traffic map

# --- Phase 2 ---
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # your chat ID (VISION ignores every other chat)

# --- Phase 3 (News Desk + Weather): no keys needed ---

# --- Phase 4 (Investments) ---
# Zerodha: no key. VISION sends you a Kite login link when needed.
FYERS_APP_ID=              # from myapi.fyers.in (Redirect URL: http://127.0.0.1:8765/auth/fyers/callback)
FYERS_SECRET=
FYERS_PIN=                 # optional: lets VISION renew the daily token without a login (~15 days)
COINGECKO_API_KEY=         # optional free Demo key (works without one, with lower limits)

# --- Phase 5 (Email + Calendar): sign-in apps (see README) ---
GOOGLE_CLIENT_ID=          # Google Cloud OAuth client (Web), redirect http://127.0.0.1:8765/auth/google/callback
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=              # Microsoft Entra app, redirect http://127.0.0.1:8765/auth/microsoft/callback
MS_CLIENT_SECRET=

# --- Phase 6 (Ask engine) ---
ANTHROPIC_API_KEY=         # optional cloud model for deep work; LM Studio covers the rest

# --- Phase 7 ---
ADZUNA_APP_ID=             # Job Hunt (developer.adzuna.com, free)
ADZUNA_APP_KEY=
CLOUDFLARE_API_TOKEN=      # Web Designer deploys (token with Workers Scripts:Edit)
CLOUDFLARE_ACCOUNT_ID=
PEXELS_API_KEY=            # Web Designer stock photos (free key, pexels.com/api); optional
PIXABAY_API_KEY=           # second stock source (free key, pixabay.com/api/docs); optional, Openverse is the fallback
OPENSKY_CLIENT_ID=         # World Watch (optional; anonymous works with lower limits)
OPENSKY_CLIENT_SECRET=
OANDA_API_TOKEN=           # Trading Desk (practice account token first)
OANDA_ACCOUNT_ID=
OANDA_ENV=practice         # practice | live

# --- YouTube Manager ---
GROQ_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
